<?xml version="1.0" encoding="UTF-8" ?>
<!--
  ExternalLoads 템플릿 — GRF 를 모델 발에 적용한다.

  applied_to_body 는 모델의 body 이름과 정확히 일치해야 한다.
  force_identifier / point_identifier / torque_identifier 는 GRF 파일의 열 접두사다.
  GRF 파일마다 열 이름 규칙이 다르므로 Case 별로 확인할 것.

  ID / SO / JR 세 단계가 이 파일을 공유한다.
-->
<OpenSimDocument Version="40600">
    <ExternalLoads name="wmit_external_loads">
        <objects>
            <ExternalForce name="right_grf">
                <applied_to_body>calcn_r</applied_to_body>
                <force_expressed_in_body>ground</force_expressed_in_body>
                <point_expressed_in_body>ground</point_expressed_in_body>
                <force_identifier>ground_force_v</force_identifier>
                <point_identifier>ground_force_p</point_identifier>
                <torque_identifier>ground_torque_</torque_identifier>
                <data_source_name>Unassigned</data_source_name>
            </ExternalForce>
            <ExternalForce name="left_grf">
                <applied_to_body>calcn_l</applied_to_body>
                <force_expressed_in_body>ground</force_expressed_in_body>
                <point_expressed_in_body>ground</point_expressed_in_body>
                <force_identifier>1_ground_force_v</force_identifier>
                <point_identifier>1_ground_force_p</point_identifier>
                <torque_identifier>1_ground_torque_</torque_identifier>
                <data_source_name>Unassigned</data_source_name>
            </ExternalForce>
        </objects>
        <groups />
        <datafile>@GRF_FILE@</datafile>
        <lowpass_cutoff_frequency_for_load_kinematics>-1</lowpass_cutoff_frequency_for_load_kinematics>
    </ExternalLoads>
</OpenSimDocument>
