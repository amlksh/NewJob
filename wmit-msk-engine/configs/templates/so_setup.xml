<?xml version="1.0" encoding="UTF-8" ?>
<!--
  AnalyzeTool + StaticOptimization 템플릿 — 근육력 산출.

  use_model_force_set=true 로 모델의 근육을 그대로 쓴다.
  근활성이 1.0 에 포화되는 구간이 많으면 모델이 요구 모멘트를 못 내는 것이며,
  그 상태의 관절반력은 과소평가된다. quality 지표에 포화 비율을 남길 것.

  주의: 결과 파일 이름은 OpenSim 이 <도구이름>_StaticOptimization_<항목>.sto 로 정한다.
  설정으로 바꿀 수 없으므로, msk_engine.steps.analysis_output_path() 가
  이 XML 의 도구 이름과 분석 이름을 읽어 기대 경로를 만든다.
  아래 name 속성을 바꾸면 결과 파일 이름도 같이 바뀐다.

  external_loads_file 은 GRF 가 없으면 Unassigned 로 치환된다.
-->
<OpenSimDocument Version="40600">
    <AnalyzeTool name="wmit_so">
        <model_file>@ANALYSIS_MODEL@</model_file>
        <results_directory>@RUN_DIR@/results</results_directory>

        <initial_time>@TIME_START@</initial_time>
        <final_time>@TIME_END@</final_time>
        <solve_for_equilibrium_for_auxiliary_states>false</solve_for_equilibrium_for_auxiliary_states>

        <AnalysisSet name="Analyses">
            <objects>
                <StaticOptimization name="StaticOptimization">
                    <on>true</on>
                    <start_time>@TIME_START@</start_time>
                    <end_time>@TIME_END@</end_time>
                    <step_interval>1</step_interval>
                    <in_degrees>true</in_degrees>
                    <use_model_force_set>true</use_model_force_set>
                    <activation_exponent>2</activation_exponent>
                    <use_muscle_physiology>true</use_muscle_physiology>
                    <optimizer_convergence_criterion>0.0001</optimizer_convergence_criterion>
                    <optimizer_max_iterations>100</optimizer_max_iterations>
                </StaticOptimization>
            </objects>
            <groups />
        </AnalysisSet>

        <external_loads_file>@EXTERNAL_LOADS@</external_loads_file>
        <coordinates_file>@IK_MOTION@</coordinates_file>
        <lowpass_cutoff_frequency_for_coordinates>6</lowpass_cutoff_frequency_for_coordinates>
        <output_precision>8</output_precision>
    </AnalyzeTool>
</OpenSimDocument>
