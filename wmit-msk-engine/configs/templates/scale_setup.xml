<?xml version="1.0" encoding="UTF-8" ?>
<!--
  ScaleTool 템플릿.
  대문자 자리표시자(앞뒤를 @ 로 감싼 형태)는 msk_engine.steps.render_setup_xml 이 치환한다.
  치환되지 않은 자리표시자가 남으면 실행 전에 실패하므로,
  주석에도 치환 대상이 아닌 자리표시자 형태를 쓰지 말 것.

  주의: MarkerPlacer 의 마커 가중치는 모델·마커셋에 맞춰 조정해야 한다.
  아래 값은 자리표시자이며, 실제 값은 ADR 로 근거를 남기고 정할 것.
-->
<OpenSimDocument Version="40600">
    <ScaleTool name="wmit_scale">
        <mass>@SUBJECT_MASS@</mass>
        <height>@SUBJECT_HEIGHT@</height>
        <age>-1</age>
        <notes>WMIT MSK engine — generated, do not edit by hand</notes>

        <GenericModelMaker name="generic">
            <model_file>@MODEL_FILE@</model_file>
            <marker_set_file>Unassigned</marker_set_file>
        </GenericModelMaker>

        <ModelScaler name="scaler">
            <apply>true</apply>
            <scaling_order> measurements </scaling_order>
            <MeasurementSet>
                <objects />
                <groups />
            </MeasurementSet>
            <marker_file>@STATIC_TRIAL@</marker_file>
            <time_range> @STATIC_TIME_START@ @STATIC_TIME_END@ </time_range>
            <preserve_mass_distribution>true</preserve_mass_distribution>
            <output_model_file>@SCALED_MODEL@</output_model_file>
            <!-- 적용된 스케일 계수. 어떤 피험자에 얼마를 곱했는지 남아야
                 결과를 재현하고 설명할 수 있다 (V&V 추적). -->
            <output_scale_file>@SCALE_FACTORS@</output_scale_file>
        </ModelScaler>

        <MarkerPlacer name="placer">
            <apply>true</apply>
            <IKTaskSet>
                <objects />
                <groups />
            </IKTaskSet>
            <marker_file>@STATIC_TRIAL@</marker_file>
            <time_range> @STATIC_TIME_START@ @STATIC_TIME_END@ </time_range>
            <output_model_file>@SCALED_MODEL@</output_model_file>
            <output_marker_file>@RUN_DIR@/results/scaled_markers.xml</output_marker_file>
        </MarkerPlacer>
    </ScaleTool>
</OpenSimDocument>
