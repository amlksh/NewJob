<?xml version="1.0" encoding="UTF-8" ?>
<!--
  InverseDynamicsTool 템플릿 — 관절 모멘트와 잔차 산출.

  external_loads_file 은 GRF 를 모델에 적용하는 설정이다.
  GRF 없이 돌린 ID 결과는 신뢰할 수 없으므로, 입력 검증에서 경고를 낸다.

  lowpass_cutoff_frequency_for_coordinates: 문헌에서 보행 해석에 6 Hz 를 흔히 쓰나,
  이 과제의 값은 민감도 분석 후 ADR 로 확정할 것 (P1).
-->
<OpenSimDocument Version="40600">
    <InverseDynamicsTool name="wmit_id">
        <model_file>@SCALED_MODEL@</model_file>
        <results_directory>@RUN_DIR@/results</results_directory>

        <time_range> @TIME_START@ @TIME_END@ </time_range>
        <forces_to_exclude> Muscles </forces_to_exclude>

        <external_loads_file>@EXTERNAL_LOADS@</external_loads_file>
        <coordinates_file>@IK_MOTION@</coordinates_file>
        <lowpass_cutoff_frequency_for_coordinates>6</lowpass_cutoff_frequency_for_coordinates>

        <output_gen_force_file>@ID_FORCES@</output_gen_force_file>
    </InverseDynamicsTool>
</OpenSimDocument>
