<?xml version="1.0" encoding="UTF-8" ?>
<!--
  AnalyzeTool + JointReaction 템플릿 — 관절반력 산출.

  핵심 설정 세 가지 (CLAUDE.md §4):
    joint_names       : 대상 관절. 1차는 무릎.
    apply_on_bodies   : 반력을 어느 물체에 작용시킨 것으로 볼지 (child = 경골 쪽)
    express_in_frame  : 어느 좌표계로 표현할지. @JR_FRAME@ 기본값은 tibia.
                        향후 FE 경계조건으로 넘길 때 이 좌표계가 기준이 된다.

  forces_file 은 Static Optimization 이 만든 근육력이다.
  이것 없이 돌리면 근육 기여가 빠진 반력이 나오므로 반드시 연결할 것.

  주의: 결과 파일 이름은 OpenSim 이 <도구이름>_JointReaction_<항목>.sto 로 정한다.
  설정으로 바꿀 수 없으므로, msk_engine.steps.analysis_output_path() 가
  이 XML 의 도구 이름과 분석 이름을 읽어 기대 경로를 만든다.
  아래 name 속성을 바꾸면 결과 파일 이름도 같이 바뀐다.

  external_loads_file 은 GRF 가 없으면 Unassigned 로 치환된다.
-->
<OpenSimDocument Version="40600">
    <AnalyzeTool name="wmit_jr">
        <model_file>@SCALED_MODEL@</model_file>
        <results_directory>@RUN_DIR@/results</results_directory>

        <initial_time>@TIME_START@</initial_time>
        <final_time>@TIME_END@</final_time>

        <AnalysisSet name="Analyses">
            <objects>
                <JointReaction name="JointReaction">
                    <on>true</on>
                    <start_time>@TIME_START@</start_time>
                    <end_time>@TIME_END@</end_time>
                    <step_interval>1</step_interval>
                    <in_degrees>true</in_degrees>
                    <forces_file>@SO_FORCES@</forces_file>
                    <joint_names> knee_r </joint_names>
                    <apply_on_bodies> child </apply_on_bodies>
                    <express_in_frame> @JR_FRAME@ </express_in_frame>
                </JointReaction>
            </objects>
            <groups />
        </AnalysisSet>

        <external_loads_file>@EXTERNAL_LOADS@</external_loads_file>
        <coordinates_file>@IK_MOTION@</coordinates_file>
        <lowpass_cutoff_frequency_for_coordinates>6</lowpass_cutoff_frequency_for_coordinates>
        <output_precision>8</output_precision>
    </AnalyzeTool>
</OpenSimDocument>
