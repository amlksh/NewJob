<?xml version="1.0" encoding="UTF-8" ?>
<!--
  InverseKinematicsTool 템플릿 — 관절각(ROM) 산출.

  report_errors 를 켜면 마커 오차 STO 가 생성되고,
  msk_engine.quality 가 이 파일에서 RMS·최대 오차를 읽는다.
  품질 지표 없이 결과만 보고하지 않기 위해 반드시 유지할 것.

  주의: 마커 오차 파일 이름은 OpenSim 이 정한다 — <도구이름>_ik_marker_errors.sto.
  아래 name 속성을 바꾸면 파일 이름도 같이 바뀐다.
  msk_engine.steps.ik_marker_error_path() 가 이 XML 에서 이름을 읽어 경로를 만든다.

  time_range 는 Case 의 time_range, 없으면 마커 파일 전체 구간으로 치환된다.
  치환을 빼먹으면 0 0 구간이 되어 한 프레임만 풀린다.
-->
<OpenSimDocument Version="40600">
    <InverseKinematicsTool name="wmit_ik">
        <model_file>@SCALED_MODEL@</model_file>
        <results_directory>@RUN_DIR@/results</results_directory>

        <IKTaskSet>
            <objects />
            <groups />
        </IKTaskSet>

        <marker_file>@MARKER_FILE@</marker_file>
        <coordinate_file>Unassigned</coordinate_file>
        <time_range> @TIME_START@ @TIME_END@ </time_range>

        <report_errors>true</report_errors>
        <output_motion_file>@IK_MOTION@</output_motion_file>
        <report_marker_locations>false</report_marker_locations>
        <constraint_weight>Inf</constraint_weight>
        <accuracy>1e-05</accuracy>
    </InverseKinematicsTool>
</OpenSimDocument>
