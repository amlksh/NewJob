{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "twinos://contracts/twin-agent/v1/validate-output.schema.json",
  "title": "ValidateOutput",
  "description": "Spec §4.2 — validate action outputs. items 인라인 최대 200개(64KB 규칙).",
  "type": "object",
  "required": ["verdicts"],
  "properties": {
    "verdicts": {
      "type": "object",
      "required": ["ref", "n_cases", "n_pass", "n_fail"],
      "properties": {
        "ref": {"type": "string", "pattern": "^urn:dtos:asset:"},
        "n_cases": {"type": "integer", "minimum": 0},
        "n_pass": {"type": "integer", "minimum": 0},
        "n_fail": {"type": "integer", "minimum": 0},
        "items": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "required": ["case_id", "qoi", "measured", "limit", "direction", "verdict"],
            "properties": {
              "case_id": {"type": "string"},
              "qoi": {"type": "string"},
              "measured": {"type": "number"},
              "limit": {"type": "number"},
              "direction": {"enum": ["max", "min"]},
              "verdict": {"enum": ["pass", "fail"]},
              "evidence_ref": {"type": "string"}
            }
          }
        }
      }
    },
    "worst_cases": {"type": "array", "items": {"type": "string"}}
  }
}
